# ==========================================
# TERRAFORM
# ==========================================
# Local .terraform directories
**/.terraform/*
**/.terraform/

# .tfstate files (contém estado e dados sensíveis gerados em tempo de execução)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Arquivos de variáveis locais com senhas (manter apenas o .example rastreado)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# ==========================================
# DOCKER LOCAL DATA
# ==========================================
# Ignora dados binários dos bancos de dados persistidos localmente
.docker/data/*
!.docker/data/.gitignore

# ==========================================
# JAVA & BUILD
# ==========================================
**/target/
flowtask/target/
*.class
.mvn/timing.properties

# ==========================================
# IDE & OS
# ==========================================
.DS_Store
Thumbs.db